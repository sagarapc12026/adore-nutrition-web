# Public site URL (used for canonical URLs, sitemap, OG)
NEXT_PUBLIC_SITE_URL=https://adorenutrition.app

# ---- Waitlist provider -------------------------------------------------
# launchlist | resend   (leave unset in local dev to log signups to the console)
WAITLIST_PROVIDER=resend

# Resend — https://resend.com/audiences
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# LaunchList — the form key from your LaunchList dashboard (Integrations → API / form endpoint)
LAUNCHLIST_API_KEY=
# Optional: LaunchList endpoint that returns your signup count as JSON ({ count } or { total })
LAUNCHLIST_COUNT_URL=

# Shown in "N mamas already on the list" only if the provider count can't be fetched.
# Leave blank to hide the number instead of guessing.
WAITLIST_FALLBACK_COUNT=

# ---- Rate limiting (optional; falls back to in-memory) -----------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Analytics (Plausible) ---------------------------------------------
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Optional custom Plausible host (self-hosted or proxied)
NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.tagged-events.js
